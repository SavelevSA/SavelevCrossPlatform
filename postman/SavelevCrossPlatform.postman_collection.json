{
  "info": {
    "_postman_id": "e9a0173f-5131-4e8f-98b3-66ea6d985562",
    "name": "Система контроля лабораторного стенда",
    "description": "Сначала войдите под student и admin: токены сохраняются в переменных коллекции. Тестовые преподаватель, работа и аудитория создаются перед отчётом, их ID сохраняются автоматически. Затем проверяются 401/403, CRUD и сводные запросы. Учебные JWT действуют два часа.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Вход по логину и паролю",
      "item": [
        {
          "name": "Вход пользователя",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userLogin}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"userToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
